{
  "name": "jarvis-vscode-extension",
  "displayName": "JARVIS",
  "description": "Local sidebar bridge between VS Code and JARVIS.",
  "version": "0.1.0",
  "publisher": "jarvis-local",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:jarvis.openPanel",
    "onCommand:jarvis.setConnectionToken",
    "onView:jarvis.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jarvis.openPanel",
        "title": "JARVIS: Open Panel"
      },
      {
        "command": "jarvis.setConnectionToken",
        "title": "JARVIS: Set Connection Token"
      }
    ],
    "languageModelTools": [
      {
        "name": "jarvis_ask",
        "toolReferenceName": "jarvisAsk",
        "displayName": "Ask JARVIS",
        "modelDescription": "Sends a natural-language request to the local JARVIS assistant (which can use its skills and connectors) and returns its reply.",
        "userDescription": "Ask the local JARVIS assistant.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "description": "The request for JARVIS."
            }
          },
          "required": ["prompt"]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jarvis",
          "title": "JARVIS",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "jarvis": [
        {
          "id": "jarvis.sidebar",
          "name": "JARVIS"
        }
      ]
    },
    "configuration": {
      "title": "JARVIS",
      "properties": {
        "jarvis.wsPort": {
          "type": "number",
          "default": 8765,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local JARVIS WebSocket server port."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
